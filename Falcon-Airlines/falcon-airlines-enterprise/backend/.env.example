# Falcon Airlines Backend - Environment Variables Template
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# Never commit .env to version control.

# ============================================
# Aviationstack API Configuration
# ============================================
# Get your API key at: https://aviationstack.com/dashboard
# Free tier: 100 requests/month
# Paid plans available for production use
AVIATIONSTACK_API_KEY=a9f54a7f435dd3ddd896c23f7ccefdd0
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# ============================================
# Flight Data Provider
# ============================================
# Options:
#   mock           - Use only Falcon's internal database (no external API calls)
#   aviationstack  - Use Aviationstack live API with database fallback
FLIGHT_PROVIDER=mock

# ============================================
# PostgreSQL Database
# ============================================
# Default values work with docker-compose.yml
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/falcon_airlines
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ============================================
# JWT Configuration
# ============================================
# Change this in production! Use a strong random secret.
# JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters

# ============================================
# Server Configuration
# ============================================
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev
